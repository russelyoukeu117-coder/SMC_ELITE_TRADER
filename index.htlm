<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMC ELITE - Formation Trading Smart Money Concepts</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --primary: #00c853;
            --text: #c9d1d9;
            --text-white: #ffffff;
            --accent: #2188ff;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text);
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        header {
            text-align: center;
            padding: 50px 20px;
            background: linear-gradient(180deg, #161b22 0%, #0d1117 100%);
        }
        h1 {
            color: var(--text-white);
            font-size: 2.2em;
            margin-bottom: 10px;
        }
        .subtitle {
            font-size: 1.1em;
            color: var(--primary);
            max-width: 800px;
            margin: 0 auto 20px auto;
        }
        .container {
            max-width: 1000px;
            margin: auto;
            padding: 20px;
        }
        .section {
            background: var(--card-bg);
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
            border: 1px solid #30363d;
        }
        h2 {
            color: var(--text-white);
            border-bottom: 2px solid var(--primary);
            padding-bottom: 10px;
        }
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        .price-card {
            background: var(--card-bg);
            border: 1px solid #30363d;
            border-radius: 10px;
            padding: 25px;
            text-align: center;
            position: relative;
        }
        .price-card.featured {
            border: 2px solid var(--primary);
        }
        .badge {
            background: var(--primary);
            color: #000;
            padding: 5px 10px;
            font-weight: bold;
            border-radius: 5px;
            position: absolute;
            top: -15px;
            right: 20px;
        }
        .price {
            font-size: 2em;
            color: var(--text-white);
            margin: 15px 0;
        }
        .btn {
            display: inline-block;
            background: var(--primary);
            color: #000;
            padding: 12px 20px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 5px;
            margin-top: 20px;
            cursor: pointer;
            width: 90%;
        }
        .btn:hover {
            opacity: 0.9;
        }
        ul {
            text-align: left;
            padding-left: 20px;
        }
        li {
            margin-bottom: 10px;
        }
        .pay-box {
            background: #0d1117;
            border: 1px dashed var(--primary);
            padding: 15px;
            margin-top: 15px;
            border-radius: 8px;
            font-size: 0.9em;
        }
    </style>
</head>
<body>

